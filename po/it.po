#: src/aptkeyman.py
msgid ""
"Usage: aptkeyman COMMAND [OPTION]...\n"
"Manage third-party APT OpenPGP keys for sources.list entries.\n"
msgstr ""
"Uso: aptkeyman COMANDO [OPZIONE]...\n"
"Gestisce le chiavi OpenPGP APT di terze parti per le voci sources.list.\n"

#: src/aptkeyman.py
msgid "Commands:\n"
msgstr "Comandi:\n"

#: src/aptkeyman.py
msgid "download missing keys used by sources lists"
msgstr "scarica le chiavi mancanti usate dagli elenchi delle fonti"

#: src/aptkeyman.py
msgid "refresh keys for sources; purge unused managed keys"
msgstr "aggiorna le chiavi delle fonti; elimina le chiavi gestite inutilizzate"

#: src/aptkeyman.py
msgid "verify installed keyring files against the DB"
msgstr "verifica i file keyring installati rispetto al DB"

#: src/aptkeyman.py
msgid "seed DB from keyrings / wellknown / apt-get update misses"
msgstr "inizializza il DB da keyrings / wellknown / errori di apt-get update"

#: src/aptkeyman.py
msgid "scan apt sources and show key matches"
msgstr "analizza le fonti apt e mostra le corrispondenze delle chiavi"

#: src/aptkeyman.py
msgid "list key facts in the database"
msgstr "elenca i fatti chiave nel database"

#: src/aptkeyman.py
msgid "show one key fact as JSON"
msgstr "mostra un fatto chiave come JSON"

#: src/aptkeyman.py
msgid "mark key fact(s) as accepted"
msgstr "segna i fatti chiave come accettati"

#: src/aptkeyman.py
msgid "mark key fact(s) as denied"
msgstr "segna i fatti chiave come rifiutati"

#: src/aptkeyman.py
msgid "add or update a key fact"
msgstr "aggiungi o aggiorna un fatto chiave"

#: src/aptkeyman.py
msgid "fetch key blob into the DB"
msgstr "recupera il blob della chiave nel DB"

#: src/aptkeyman.py
msgid "dump DB as JSON"
msgstr "esporta il DB come JSON"

#: src/aptkeyman.py
msgid "merge external JSON data into the DB"
msgstr "unisci dati JSON esterni nel DB"

#: src/aptkeyman.py
msgid "open wxPython GUI"
msgstr "apri l'interfaccia wxPython"

#: src/aptkeyman.py
msgid "print DB path"
msgstr "stampa il percorso del DB"

#: src/aptkeyman.py
msgid "print version information"
msgstr "stampa le informazioni di versione"

#: src/aptkeyman.py
msgid "show this help"
msgstr "mostra questo aiuto"

#: src/aptkeyman.py
msgid "Typical flow: aptkeyman seed && sudo aptkeyman download && sudo apt-get update\n"
msgstr "Flusso tipico: aptkeyman seed && sudo aptkeyman download && sudo apt-get update\n"

#: src/aptkeyman.py
msgid "Report bugs to: <{email}>\n"
msgstr "Segnalare i bug a: <{email}>\n"

