#: src/aptkeyman.py
msgid ""
"Usage: aptkeyman COMMAND [OPTION]...\n"
"Manage third-party APT OpenPGP keys for sources.list entries.\n"
msgstr ""
"Usage : aptkeyman COMMANDE [OPTION]...\n"
"Gérer les clés OpenPGP APT tierces pour les entrées sources.list.\n"

#: src/aptkeyman.py
msgid "Commands:\n"
msgstr "Commandes :\n"

#: src/aptkeyman.py
msgid "download missing keys used by sources lists"
msgstr "télécharger les clés manquantes utilisées par les listes de sources"

#: src/aptkeyman.py
msgid "refresh keys for sources; purge unused managed keys"
msgstr "rafraîchir les clés des sources ; purger les clés gérées inutilisées"

#: src/aptkeyman.py
msgid "verify installed keyring files against the DB"
msgstr "vérifier les fichiers de trousseau installés par rapport à la BD"

#: src/aptkeyman.py
msgid "seed DB from keyrings / wellknown / apt-get update misses"
msgstr "ensemencer la BD depuis keyrings / wellknown / erreurs apt-get update"

#: src/aptkeyman.py
msgid "scan apt sources and show key matches"
msgstr "parcourir les sources apt et afficher les correspondances de clés"

#: src/aptkeyman.py
msgid "list key facts in the database"
msgstr "lister les faits de clés dans la base"

#: src/aptkeyman.py
msgid "show one key fact as JSON"
msgstr "afficher un fait de clé en JSON"

#: src/aptkeyman.py
msgid "mark key fact(s) as accepted"
msgstr "marquer le(s) fait(s) de clé comme acceptés"

#: src/aptkeyman.py
msgid "mark key fact(s) as denied"
msgstr "marquer le(s) fait(s) de clé comme refusés"

#: src/aptkeyman.py
msgid "add or update a key fact"
msgstr "ajouter ou mettre à jour un fait de clé"

#: src/aptkeyman.py
msgid "fetch key blob into the DB"
msgstr "récupérer le blob de clé dans la BD"

#: src/aptkeyman.py
msgid "dump DB as JSON"
msgstr "exporterer la BD en JSON"

#: src/aptkeyman.py
msgid "merge external JSON data into the DB"
msgstr "fusionner des données JSON externes dans la BD"

#: src/aptkeyman.py
msgid "open wxPython GUI"
msgstr "ouvrir l'interface wxPython"

#: src/aptkeyman.py
msgid "print DB path"
msgstr "afficher le chemin de la BD"

#: src/aptkeyman.py
msgid "print version information"
msgstr "afficher les informations de version"

#: src/aptkeyman.py
msgid "show this help"
msgstr "afficher cette aide"

#: src/aptkeyman.py
msgid "Typical flow: aptkeyman seed && sudo aptkeyman download && sudo apt-get update\n"
msgstr "Flux typique : aptkeyman seed && sudo aptkeyman download && sudo apt-get update\n"

#: src/aptkeyman.py
msgid "Report bugs to: <{email}>\n"
msgstr "Signaler les bogues à : <{email}>\n"

