#: src/aptkeyman.py
msgid ""
"Usage: aptkeyman COMMAND [OPTION]...\n"
"Manage third-party APT OpenPGP keys for sources.list entries.\n"
msgstr ""
"Uso: aptkeyman COMANDO [OPCIÓN]...\n"
"Administra claves OpenPGP APT de terceros para entradas de sources.list.\n"

#: src/aptkeyman.py
msgid "Commands:\n"
msgstr "Comandos:\n"

#: src/aptkeyman.py
msgid "download missing keys used by sources lists"
msgstr "descargar claves faltantes usadas por las listas de fuentes"

#: src/aptkeyman.py
msgid "refresh keys for sources; purge unused managed keys"
msgstr "actualizar claves de fuentes; purgar claves gestionadas no usadas"

#: src/aptkeyman.py
msgid "verify installed keyring files against the DB"
msgstr "verificar archivos de llavero instalados frente a la BD"

#: src/aptkeyman.py
msgid "seed DB from keyrings / wellknown / apt-get update misses"
msgstr "sembrar la BD desde keyrings / wellknown / fallos de apt-get update"

#: src/aptkeyman.py
msgid "scan apt sources and show key matches"
msgstr "examinar fuentes apt y mostrar coincidencias de claves"

#: src/aptkeyman.py
msgid "list key facts in the database"
msgstr "listar hechos de claves en la base de datos"

#: src/aptkeyman.py
msgid "show one key fact as JSON"
msgstr "mostrar un hecho de clave como JSON"

#: src/aptkeyman.py
msgid "mark key fact(s) as accepted"
msgstr "marcar hecho(s) de clave como aceptados"

#: src/aptkeyman.py
msgid "mark key fact(s) as denied"
msgstr "marcar hecho(s) de clave como denegados"

#: src/aptkeyman.py
msgid "add or update a key fact"
msgstr "añadir o actualizar un hecho de clave"

#: src/aptkeyman.py
msgid "fetch key blob into the DB"
msgstr "obtener el blob de clave en la BD"

#: src/aptkeyman.py
msgid "dump DB as JSON"
msgstr "volcar la BD como JSON"

#: src/aptkeyman.py
msgid "merge external JSON data into the DB"
msgstr "fusionar datos JSON externos en la BD"

#: src/aptkeyman.py
msgid "open wxPython GUI"
msgstr "abrir la GUI de wxPython"

#: src/aptkeyman.py
msgid "print DB path"
msgstr "imprimir la ruta de la BD"

#: src/aptkeyman.py
msgid "print version information"
msgstr "imprimir información de versión"

#: src/aptkeyman.py
msgid "show this help"
msgstr "mostrar esta ayuda"

#: src/aptkeyman.py
msgid "Typical flow: aptkeyman seed && sudo aptkeyman download && sudo apt-get update\n"
msgstr "Flujo típico: aptkeyman seed && sudo aptkeyman download && sudo apt-get update\n"

#: src/aptkeyman.py
msgid "Report bugs to: <{email}>\n"
msgstr "Informar errores a: <{email}>\n"

