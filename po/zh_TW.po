#: src/aptkeyman.py
msgid ""
"Usage: aptkeyman COMMAND [OPTION]...\n"
"Manage third-party APT OpenPGP keys for sources.list entries.\n"
msgstr ""
"用法：aptkeyman 命令 [選項]...\n"
"管理 sources.list 項目所需的第三方 APT OpenPGP 金鑰。\n"

#: src/aptkeyman.py
msgid "Commands:\n"
msgstr "命令：\n"

#: src/aptkeyman.py
msgid "download missing keys used by sources lists"
msgstr "下載 sources 列表所用的缺失金鑰"

#: src/aptkeyman.py
msgid "refresh keys for sources; purge unused managed keys"
msgstr "重新整理 sources 所用金鑰；清除未使用的託管金鑰"

#: src/aptkeyman.py
msgid "verify installed keyring files against the DB"
msgstr "對照資料庫校驗已安裝的金鑰環檔案"

#: src/aptkeyman.py
msgid "seed DB from keyrings / wellknown / apt-get update misses"
msgstr "從 keyrings / wellknown / apt-get update 缺金鑰資訊播種資料庫"

#: src/aptkeyman.py
msgid "scan apt sources and show key matches"
msgstr "掃描 apt 來源並顯示金鑰匹配"

#: src/aptkeyman.py
msgid "list key facts in the database"
msgstr "列出資料庫中的金鑰事實"

#: src/aptkeyman.py
msgid "show one key fact as JSON"
msgstr "以 JSON 顯示一條金鑰事實"

#: src/aptkeyman.py
msgid "mark key fact(s) as accepted"
msgstr "將金鑰事實標記為已接受"

#: src/aptkeyman.py
msgid "mark key fact(s) as denied"
msgstr "將金鑰事實標記為已拒絕"

#: src/aptkeyman.py
msgid "add or update a key fact"
msgstr "新增或更新一條金鑰事實"

#: src/aptkeyman.py
msgid "fetch key blob into the DB"
msgstr "將金鑰資料拉取到資料庫"

#: src/aptkeyman.py
msgid "dump DB as JSON"
msgstr "將資料庫匯出為 JSON"

#: src/aptkeyman.py
msgid "merge external JSON data into the DB"
msgstr "將外部 JSON 合併進資料庫"

#: src/aptkeyman.py
msgid "open wxPython GUI"
msgstr "開啟 wxPython 圖形介面"

#: src/aptkeyman.py
msgid "print DB path"
msgstr "列印資料庫路徑"

#: src/aptkeyman.py
msgid "print version information"
msgstr "列印版本資訊"

#: src/aptkeyman.py
msgid "show this help"
msgstr "顯示此說明"

#: src/aptkeyman.py
msgid "Typical flow: aptkeyman seed && sudo aptkeyman download && sudo apt-get update\n"
msgstr "典型流程：aptkeyman seed && sudo aptkeyman download && sudo apt-get update\n"

#: src/aptkeyman.py
msgid "Report bugs to: <{email}>\n"
msgstr "回報問題：<{email}>\n"

