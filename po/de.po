#: src/aptkeyman.py
msgid ""
"Usage: aptkeyman COMMAND [OPTION]...\n"
"Manage third-party APT OpenPGP keys for sources.list entries.\n"
msgstr ""
"Aufruf: aptkeyman BEFEHL [OPTION]...\n"
"Drittanbieter-APT-OpenPGP-Schlüssel für sources.list-Einträge verwalten.\n"

#: src/aptkeyman.py
msgid "Commands:\n"
msgstr "Befehle:\n"

#: src/aptkeyman.py
msgid "download missing keys used by sources lists"
msgstr "fehlende von Quellenlisten genutzte Schlüssel herunterladen"

#: src/aptkeyman.py
msgid "refresh keys for sources; purge unused managed keys"
msgstr "Schlüssel für Quellen aktualisieren; ungenutzte verwaltete Schlüssel entfernen"

#: src/aptkeyman.py
msgid "verify installed keyring files against the DB"
msgstr "installierte Schlüsselbunddateien gegen die DB prüfen"

#: src/aptkeyman.py
msgid "seed DB from keyrings / wellknown / apt-get update misses"
msgstr "DB aus keyrings / wellknown / apt-get-update-Fehlern befüllen"

#: src/aptkeyman.py
msgid "scan apt sources and show key matches"
msgstr "APT-Quellen scannen und Schlüsseltreffer anzeigen"

#: src/aptkeyman.py
msgid "list key facts in the database"
msgstr "Schlüsselfakten in der Datenbank auflisten"

#: src/aptkeyman.py
msgid "show one key fact as JSON"
msgstr "einen Schlüsselfakt als JSON anzeigen"

#: src/aptkeyman.py
msgid "mark key fact(s) as accepted"
msgstr "Schlüsselfakt(en) als akzeptiert markieren"

#: src/aptkeyman.py
msgid "mark key fact(s) as denied"
msgstr "Schlüsselfakt(en) als abgelehnt markieren"

#: src/aptkeyman.py
msgid "add or update a key fact"
msgstr "Schlüsselfakt hinzufügen oder aktualisieren"

#: src/aptkeyman.py
msgid "fetch key blob into the DB"
msgstr "Schlüsselblob in die DB holen"

#: src/aptkeyman.py
msgid "dump DB as JSON"
msgstr "DB als JSON ausgeben"

#: src/aptkeyman.py
msgid "merge external JSON data into the DB"
msgstr "externe JSON-Daten in die DB mergen"

#: src/aptkeyman.py
msgid "open wxPython GUI"
msgstr "wxPython-Oberfläche öffnen"

#: src/aptkeyman.py
msgid "print DB path"
msgstr "DB-Pfad ausgeben"

#: src/aptkeyman.py
msgid "print version information"
msgstr "Versionsinformationen ausgeben"

#: src/aptkeyman.py
msgid "show this help"
msgstr "diese Hilfe anzeigen"

#: src/aptkeyman.py
msgid "Typical flow: aptkeyman seed && sudo aptkeyman download && sudo apt-get update\n"
msgstr "Typischer Ablauf: aptkeyman seed && sudo aptkeyman download && sudo apt-get update\n"

#: src/aptkeyman.py
msgid "Report bugs to: <{email}>\n"
msgstr "Fehler melden an: <{email}>\n"

