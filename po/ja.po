#: src/aptkeyman.py
msgid ""
"Usage: aptkeyman COMMAND [OPTION]...\n"
"Manage third-party APT OpenPGP keys for sources.list entries.\n"
msgstr ""
"使い方: aptkeyman コマンド [オプション]...\n"
"sources.list エントリ用のサードパーティ APT OpenPGP 鍵を管理します。\n"

#: src/aptkeyman.py
msgid "Commands:\n"
msgstr "コマンド:\n"

#: src/aptkeyman.py
msgid "download missing keys used by sources lists"
msgstr "sources リストで使う不足キーをダウンロード"

#: src/aptkeyman.py
msgid "refresh keys for sources; purge unused managed keys"
msgstr "sources の鍵を更新し、未使用の管理鍵を削除"

#: src/aptkeyman.py
msgid "verify installed keyring files against the DB"
msgstr "インストール済みキーリングを DB と照合"

#: src/aptkeyman.py
msgid "seed DB from keyrings / wellknown / apt-get update misses"
msgstr "keyrings / wellknown / apt-get update 欠落から DB を初期化"

#: src/aptkeyman.py
msgid "scan apt sources and show key matches"
msgstr "apt ソースを走査して鍵の一致を表示"

#: src/aptkeyman.py
msgid "list key facts in the database"
msgstr "データベースの鍵ファクトを一覧表示"

#: src/aptkeyman.py
msgid "show one key fact as JSON"
msgstr "1 件の鍵ファクトを JSON で表示"

#: src/aptkeyman.py
msgid "mark key fact(s) as accepted"
msgstr "鍵ファクトを受理済みにする"

#: src/aptkeyman.py
msgid "mark key fact(s) as denied"
msgstr "鍵ファクトを拒否済みにする"

#: src/aptkeyman.py
msgid "add or update a key fact"
msgstr "鍵ファクトを追加または更新"

#: src/aptkeyman.py
msgid "fetch key blob into the DB"
msgstr "鍵ブロブを DB に取得"

#: src/aptkeyman.py
msgid "dump DB as JSON"
msgstr "DB を JSON で出力"

#: src/aptkeyman.py
msgid "merge external JSON data into the DB"
msgstr "外部 JSON を DB にマージ"

#: src/aptkeyman.py
msgid "open wxPython GUI"
msgstr "wxPython GUI を開く"

#: src/aptkeyman.py
msgid "print DB path"
msgstr "DB パスを表示"

#: src/aptkeyman.py
msgid "print version information"
msgstr "バージョン情報を表示"

#: src/aptkeyman.py
msgid "show this help"
msgstr "このヘルプを表示"

#: src/aptkeyman.py
msgid "Typical flow: aptkeyman seed && sudo aptkeyman download && sudo apt-get update\n"
msgstr "典型的な流れ: aptkeyman seed && sudo aptkeyman download && sudo apt-get update\n"

#: src/aptkeyman.py
msgid "Report bugs to: <{email}>\n"
msgstr "バグ報告先: <{email}>\n"

